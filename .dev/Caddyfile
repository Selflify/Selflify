{
    admin 0.0.0.0:2019
    email dev@sendsay.dev
    auto_https off
}

(common_headers) {
    header {
        X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Content-Type-Options "nosniff"
    }
}

(static_cache) {
    @static {
        path *.js *.mjs *.css *.map *.png *.jpg *.jpeg *.gif *.svg *.webp *.ico *.woff *.woff2 *.ttf *.eot
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    @html {
        path *.html /
    }
    header @html Cache-Control "no-store, no-cache, must-revalidate"
}

(common_site) {
    import common_headers
    import static_cache

    encode gzip zstd
}

http://sendsay.dev {
    import common_site

    reverse_proxy selflify:3000
}

http://app.sendsay.dev, http://*.app.sendsay.dev {
    import common_site

    @preview expression `{host} != "app.sendsay.dev"`

    handle @preview {
        root * /var/www/app/{labels.3}
        try_files {path} {path}/ /index.html
        file_server
    }

    handle {
        root * /var/www/app/stable
        try_files {path} {path}/ /index.html
        file_server
    }
}

http://chatbots.sendsay.dev, http://*.chatbots.sendsay.dev {
    import common_site

    @preview expression `{host} != "chatbots.sendsay.dev"`

    handle @preview {
        basicauth {
            nobotshere $2a$14$yljaNFg1HsgUtwps9bDhm.1T0y0Vcdu8nlg7C.iXyMil.yjmapX3a
        }

        root * /var/www/chatbots/{labels.3}
        try_files {path} {path}/ /index.html
        file_server
    }

    handle {
        root * /var/www/chatbots/stable
        try_files {path} {path}/ /index.html
        file_server
    }
}

