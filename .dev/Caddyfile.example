{
    admin 0.0.0.0:2019 {
        origins http://0.0.0.0:2019 http://127.0.0.1:2019 http://localhost:2019 http://caddy:2019
    }
    email dev@example.dev
    auto_https off
}

(common_headers) {
    header {
        X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Content-Type-Options "nosniff"
    }
}

(static_cache) {
    @static {
        path *.js *.mjs *.css *.map *.png *.jpg *.jpeg *.gif *.svg *.webp *.ico *.woff *.woff2 *.ttf *.eot
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    @html {
        path *.html /
    }
    header @html Cache-Control "no-store, no-cache, must-revalidate"
}

(common_site) {
    import common_headers
    import static_cache

    encode gzip zstd
}

http://example.dev {
    import common_site

    reverse_proxy selflify:3000
}

http://app.example.dev, http://*.app.example.dev {
    import common_site

    @preview expression `{host} != "app.example.dev"`

    handle @preview {
        root * /var/www/app/{labels.3}
        try_files {path} {path}/ /index.html
        file_server
    }

    handle {
        root * /var/www/app/stable
        try_files {path} {path}/ /index.html
        file_server
    }
}

http://chatbots.example.dev, http://*.chatbots.example.dev {
    import common_site

    @preview expression `{host} != "chatbots.example.dev"`

    handle @preview {
        basic_auth {
            nobotshere $2a$14$yljaNFg1HsgUtwps9bDhm.1T0y0Vcdu8nlg7C.iXyMil.yjmapX3a
        }

        root * /var/www/chatbots/{labels.3}
        try_files {path} {path}/ /index.html
        file_server
    }

    handle {
        root * /var/www/chatbots/stable
        try_files {path} {path}/ /index.html
        file_server
    }
}

