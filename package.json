{
  "name": "selflify",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://selflify.github.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Selflify/Selflify.git"
  },
  "packageManager": "yarn@4.13.0",
  "scripts": {
    "dev:prepare": "node ./scripts/prepare-dev-runtime.mjs",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "workflow:lint": "docker run --rm -v \"$PWD\":/repo -w /repo rhysd/actionlint:1.7.8",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:bootstrap-install": "playwright test --config=playwright.bootstrap.config.ts",
    "e2e:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit",
    "cleanup:run": "tsx ./src/bin/cleanup.ts",
    "bootstrap:bundle": "node ./scripts/build-bootstrap-bundle.mjs"
  },
  "dependencies": {
    "@chakra-ui/react": "3.34.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.14.0",
    "next": "16.2.3",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "react": "19.2.5",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.19.24",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/eslint-plugin": "^1.6.14",
    "eslint": "^9.38.0",
    "eslint-config-next": "16.2.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
